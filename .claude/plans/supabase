### 4.5 Store: `withLayoutPersistence()` custom SignalStore feature
New file **`src/app/features/builder/state/with-layout-persistence.ts`**. All persistence state stays in the SignalStore, with no BehaviorSubjects.

```ts
export type SyncStatus = 'loading' | 'load-error' | 'idle' | 'saving' | 'save-error';
export const AUTOSAVE_DEBOUNCE_MS = 500;

export function withLayoutPersistence() {
  return signalStoreFeature(
    type<{ state: { canvasElements: CanvasElement[] } }>(),
    withState({ syncStatus: 'loading' as SyncStatus, syncError: null as string | null }),
    withProps(() => ({
      _repository: inject(LAYOUT_REPOSITORY),
      _pendingTasks: inject(PendingTasks),
      _injector: inject(Injector),
    })),
    withComputed(({ syncStatus }) => ({
      /** Editing is blocked until the saved layout is in, so a late load can't clobber edits. */
      isEditable: computed(() => syncStatus() !== 'loading' && syncStatus() !== 'load-error'),
    })),
    withMethods((store) => {
      const persist = (elements: CanvasElement[]) =>
        from(store._repository.save(toLayoutData(elements))).pipe(
          tap(() => patchState(store, { syncStatus: 'idle', syncError: null })),
          catchError((error) => {
            patchState(store, { syncStatus: 'save-error', syncError: messageOf(error) });
            return EMPTY;
          }),
        );
      const autosave = rxMethod<CanvasElement[]>(pipe(
        skip(1),                                   // first emission = the layout just loaded
        tap(() => patchState(store, { syncStatus: 'saving' })),
        debounceTime(AUTOSAVE_DEBOUNCE_MS),
        concatMap(persist),                        // sequential writes, never overlapping
      ));
      const saveNow = rxMethod<void>(pipe(
        tap(() => patchState(store, { syncStatus: 'saving' })),
        concatMap(() => persist(store.canvasElements())),
      ));
      let autosaveStarted = false;

      async function load(): Promise<void> {
        patchState(store, { syncStatus: 'loading', syncError: null });
        try {
          const layout = await store._pendingTasks.run(() => store._repository.load());
          patchState(store, { canvasElements: layout ? fromLayoutData(layout) : [], syncStatus: 'idle' });
          if (!autosaveStarted) {
            autosaveStarted = true;
            autosave(store.canvasElements, { injector: store._injector });
          }
        } catch (error) {
          patchState(store, { syncStatus: 'load-error', syncError: messageOf(error) }); // autosave stays off
        }
      }

      return {
        load,
        retry(): void {
          if (store.syncStatus() === 'load-error') void load();
          else if (store.syncStatus() === 'save-error') saveNow();
        },
      };
    }),
    withHooks({ onInit: (store) => void store.load() }),
  );
}
```
Notes:
- `messageOf(error)` is a small local helper (`error instanceof Error ? error.message : String(error)`).
- Members prefixed with `_` are private to the store (NgRx SignalStore convention).
- Passing `{ injector }` to the rxMethod avoids the "called outside injection context" warning, because `autosave` starts after an `await`.
- `PendingTasks.run` keeps `ApplicationRef.whenStable()` pending until the load finishes, which gives tests a clean await point.
- After a `save-error`, the next edit retries automatically through the same pipeline. `retry()` covers the case where the user wants to retry without editing.

**`builder-store.ts` changes:**
- Use the stable palette uids (§4.2).
- Append `withLayoutPersistence()` after the existing `withMethods(...)`, i.e. `signalStore({ providedIn: 'root' }, withState(createInitialState), withMethods(...), withLayoutPersistence())`.
- The public API of the existing four methods does not change.

