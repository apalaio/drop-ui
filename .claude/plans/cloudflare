### 5.3 Store feature (`src/app/features/builder/state/with-layout-persistence.ts`)

```ts
export type SyncStatus = 'loading' | 'load-error' | 'idle' | 'saving' | 'save-error';
export function withLayoutPersistence() {
  return signalStoreFeature(
    { state: type<{ canvasElements: CanvasElement[] }>() },
    withState({ syncStatus: 'loading' as SyncStatus, _lastPersisted: null as string | null }),
    withProps(() => ({ _repo: inject(LAYOUT_REPOSITORY) })),
    withComputed(({ canvasElements, syncStatus, _lastPersisted }) => {
      const _layoutJson = computed(() => JSON.stringify(toLayoutData(canvasElements())));
      return {
        _layoutJson,
        isEditable: computed(() => syncStatus() !== 'loading' && syncStatus() !== 'load-error'),
        hasUnsavedChanges: computed(() => _lastPersisted() !== null && _layoutJson() !== _lastPersisted()),
      };
    }),
    withMethods((store) => {
      // sequential executor: one PUT at a time, in order
      const _persist = rxMethod<string>(pipe(concatMap((json) => defer(() => {
        patchState(store, { syncStatus: 'saving' });
        return from(store._repo.save(JSON.parse(json)));
      }).pipe(
        tap(() => patchState(store, { syncStatus: 'idle', _lastPersisted: json })),
        catchError(() => { patchState(store, { syncStatus: 'save-error' }); return EMPTY; }),
      ))));
      const _autosave = rxMethod<string | null>(pipe(
        debounceTime(500),
        filter((json): json is string => json !== null && json !== getState(store)._lastPersisted),
        tap((json) => _persist(json)),
      ));
      async function load() {
        patchState(store, { syncStatus: 'loading' });
        try {
          const data = await store._repo.load();
          const elements = data ? fromLayoutData(data) : [];
          patchState(store, { canvasElements: elements, syncStatus: 'idle',
                              _lastPersisted: JSON.stringify(toLayoutData(elements)) });
        } catch { patchState(store, { syncStatus: 'load-error' }); }
      }
      return {
        _autosave, load,
        retry(): void {
          if (store.syncStatus() === 'load-error') void load();
          else if (store.syncStatus() === 'save-error') _persist(store._layoutJson());
        },
      };
    }),
    withHooks({
      onInit(store) {
        // started synchronously in the injection context; emits null until a load has succeeded
        store._autosave(computed(() => (store.isEditable() && store._lastPersisted() !== null ? store._layoutJson() : null)));
        void store.load();
      },
    }),
  );
}
```

Behaviour guarantees, each covered by the spec:
- **No autosave after a failed load.** While loading or after `load-error`, the autosave source is `null` and `isEditable` is false.
- **No redundant save right after load.** `_lastPersisted` is seeded with the normalized loaded layout.
- **Debounce is applied before the dedupe filter**, so "change, then revert within 500 ms" sends nothing.
- **Saves are strictly sequential** (`concatMap`), and status returns to `idle` only after each save resolves.
- **A save error does not stop autosave.** The next edit tries again, and `retry()` re-sends the current layout immediately through the same sequential queue.
- **`retry()` after `load-error` reloads.**

Edits are expected only while `isEditable`, so the load result overwrites `canvasElements` and no merge is needed.

- **Modify** `builder-store.ts`: change it to `signalStore({ providedIn: 'root' }, withState(createInitialState), withMethods(...existing), withLayoutPersistence())`.
- **Optional:** a `beforeunload` listener in `BuilderShell` (`host: { '(window:beforeunload)': … }`) that warns when `hasUnsavedChanges() || syncStatus() === 'saving'`.

